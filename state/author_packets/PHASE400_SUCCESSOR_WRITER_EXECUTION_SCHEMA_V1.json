  "local_horizon_protocol": {
    "phase400_design_only": true,
    "future_pilot_preconditions": [
      "A separately authorized successor task exists.",
      "A focal character is selected before prose generation.",
      "A writer-visible projection is built from a frozen coordinator-only world model.",
      "Projection audit confirms hidden-state and evaluator leakage are absent.",
      "Writer entry is frozen before execution."
    ],
    "generation": {
      "fresh_isolated_writer_required": true,
      "allowed_writer_entries": 1,
      "local_passage_only": true,
      "automatic_retry": false,
      "automatic_second_window": false
    },
    "after_generation": {
      "store_output_verbatim": true,
      "freeze_output_before_evaluation": true,
      "hidden_source_fidelity_gate": true,
      "hidden_dialogue_gate": true,
      "hidden_immersion_or_ai_smell_gate": true,
      "local_repair_forbidden": true,
      "actual_human_review_only_after_required_gates_clear": true
    },
    "state_update": {
      "coordinator_may_extract_observable_state_changes_from_frozen_passage": true,
      "coordinator_may_update_hidden_world_state": true,
      "coordinator_may_not_edit_frozen_passage": true,
      "next_window_requires_new_authorization": true
    }
  },
  "audit_rules": [
    "BLOCK if the writer-visible projection contains non-focal private objectives or private knowledge.",
    "BLOCK if the full terminal world-state checklist is writer-visible.",
    "BLOCK if the writer-visible projection contains evaluator labels, thresholds, failure diagnoses or human-review answer keys.",
    "BLOCK if the writer is instructed to meet paragraph-length, question-count or dialogue-interruption quotas.",
    "BLOCK if the writer is given a future event sequence, reveal sequence or paragraph plan.",
    "BLOCK if optional scene details are marked as mandatory coverage.",
    "BLOCK if a future pilot asks the writer to complete the entire scene in one generation.",
    "BLOCK if Phase399 frozen A1 or Phase398 frozen NS02 is modified."
