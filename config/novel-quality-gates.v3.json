{
  "schema_version": "3.0.4",
  "skill": "novel-writing-master",
  "pipeline": "evidence-driven-staged-writing",
  "principles": {
    "logic_before_language": true,
    "causal_proof_before_draft": true,
    "emotion_debt_before_payoff": true,
    "located_evidence_required": true,
    "self_score_is_not_evidence": true,
    "file_presence_is_not_quality_evidence": true,
    "simulated_readers_are_not_independent": true,
    "de_ai_default_off_until_structure_stable": true,
    "dialogue_requires_scene_grounding_evidence": true,
    "semantic_time_scope_must_be_propagated": true,
    "action_beat_spam_is_not_dialogue_grounding": true,
    "dialogue_candidate_harvest_required": true,
    "social_anecdote_is_not_automatically_exposition": true,
    "rhetorical_ladder_record_parity_required": true,
    "epistemic_scope_must_precede_mouthpiece_verdict": true,
    "object_fact_is_not_public_knowledge": true,
    "single_removable_banter_is_not_automatic_hard_fail": true,
    "cross_scene_dialogue_pattern_density_belongs_to_g8": true,
    "no_universal_dialogue_density_threshold_without_evidence": true,
    "max_high_impact_changes_per_pass": 5
  },
  "severity": {
    "BLOCKER": "The core promise, causality, motivation, rule, continuity, local semantic logic, or primary payoff cannot work.",
    "MAJOR": "The problem substantially damages retention, emotion, credibility, character alignment, dialogue truthfulness, or payoff.",
    "MINOR": "The problem is local and does not break the story.",
    "STYLE": "A line-level expression issue handled only after structural and microcraft stability."
  },
  "gates": [
    {"id":"V3-G0","name":"story_contract","required_evidence":["reader_promise","one_sentence_mainline","protagonist_want","persistent_opposition","specific_failure_cost","why_now","irreversible_event","climax_choice","ending_payoff"],"blockers":["mainline_not_testable","protagonist_has_no_active_choice","ending_does_not_answer_opening_question"],"on_fail":"return_to_story_contract"},
    {"id":"V3-G1","name":"causal_proof","artifact":"scene_causal_ledger","required_evidence_per_key_scene":["prior_fact","character_choice","simpler_option","credible_reason_not_chosen","immediate_consequence","new_constraint","next_scene_pressure"],"blockers":["core_conflict_dissolves_with_unblocked_simple_action","turning_point_requires_character_stupidity","turning_point_requires_unseeded_rule_or_resource","scene_connects_only_by_authorial_then"],"on_fail":"redesign_scene_chain"},
    {"id":"V3-G2","name":"emotion_debt_and_payoff","artifact":"emotion_payoff_ledger","required_evidence":["primary_emotion_debt","debt_creator","reader_expected_return","escalation","partial_return_or_intentional_delay","final_return","material_state_change"],"blockers":["primary_debt_has_no_payoff","payoff_is_only_reaction_or_narration","payoff_requires_no_prior_pressure_or_cost"],"on_fail":"redesign_pressure_and_payoff"},
    {"id":"V3-G3","name":"hate_and_empathy","artifact":"hate_empathy_evidence","required_evidence":{"protagonist":["ordinary_want","human_flaw_or_error","costly_choice","specific_loss_or_risk"],"harm_doer":["non_harmful_option_existed","active_harm","benefit_or_control_gained","warning_ignored_or_blame_shifted","consequence_corresponds_to_harm"]},"on_fail":"redesign_character_choice_not_backstory"},
    {"id":"V3-G4","name":"draft_and_opening_retention","required_for":["short_fiction","web_fiction","public_account_fiction","short_drama_fiction"],"required_evidence":["specific_first_screen_pressure","clear_reader_question","predicament_by_first_300_chars","first_scene_state_change","exact_stop_point_or_no_fatal_stop"],"on_fail":"rewrite_only_the_failed_opening_scope"},
    {"id":"V3-G5","name":"reader_evidence","review_labels":["independent_review","simulated_reader_lens"],"required_evidence":["exact_skimming_point","exact_confusion_or_distrust_point","unmet_expectation","remembered_elements","protected_strength"],"prohibited_claims":["same_context_roleplay_claimed_as_independent","average_score_used_as_quality_proof"],"on_fail":"send_high_impact_evidence_to_revision_ledger"},
    {"id":"V3-G6","name":"continuity_and_rule_integrity","required_evidence":["character_facts","timeline","object_state","knowledge_state","spatial_logic","rule_condition_limit_cost","changed_location_chain_check"],"blockers":["confirmed_contradiction","character_uses_unknown_information","critical_object_has_no_source","rule_added_after_crisis_to_solve_crisis"],"on_fail":"resolve_canon_and_recheck_downstream"},
    {
      "id":"V3-G6D","name":"dialogue_grounding_and_local_semantic_logic","version":"1.4",
      "artifacts":["microcraft_dialogue_audit","local_semantic_logic_ledger","dialogue_candidate_inventory","rhetorical_ladder_audit_records","dialogue_epistemic_scope_records"],
      "required_evidence":["candidate_inventory_complete","multi_fact_bundle_coverage","ordinary_early_mid_dialogue_coverage","dialogue_trigger_anchor","speaker_in_scene_goal","speaker_goal_textual_evidence","object_fact","listener_object_fact_knowledge","public_knowledge_of_object_fact","reported_rumor_content","exposure_or_spread_evidence","actionable_risk_from_public_knowledge","epistemic_payload_delta","embedded_repetition_meta_claim_check","exact_bundle_no_reader_counterfactual","atomic_information_claims","pure_shared_background_mouthpiece_check","social_anecdote_carveout_check","information_carrier","non_speech_option_checked","dialogue_aftereffect","per_turn_state_delta","rhetorical_ladder_record_parity","local_vs_g8_pattern_routing","semantic_time_scope","semantic_relation_chain","action_beat_spam_check"],
      "blockers":["candidate_harvest_incomplete","rhetorical_ladder_audit_incomplete","temporal_semantic_chain_conflict","pure_shared_background_author_mouthpiece","critical_dialogue_has_no_trigger_or_goal","repair_by_action_beat_spam","locally_ungrounded_material_dialogue_pingpong"],
      "failure_codes":["DIALOGUE_CANDIDATE_HARVEST_INCOMPLETE","RHETORICAL_LADDER_AUDIT_INCOMPLETE","TEMPORAL_SEMANTIC_CHAIN_FAIL","AUTHOR_INFORMATION_MOUTHPIECE_FAIL","DIALOGUE_PINGPONG_TEMPLATE_WITHOUT_CHARACTER_MOTIVE","CRITICAL_DIALOGUE_HAS_NO_TRIGGER_OR_GOAL","ACTION_BEAT_SPAM_AS_FAKE_GROUNDING"],
      "calibration":{"known_object_fact_does_not_imply_known_public_knowledge":true,"unsupported_public_knowledge_claim_defaults_to_hold":true,"single_context_supported_removable_banter_is_not_auto_blocker":true,"portable_locally_plausible_cadence_routes_to_g8":true},
      "on_fail":"repair_local_logic_or_dialogue_grounding_then_rerun_G6D"
    },
    {"id":"V3-G7","name":"targeted_revision","max_high_impact_issues_per_pass":5,"required_evidence":["located_problem","root_cause","bounded_change","protected_strength","downstream_recheck"],"on_fail":"reopen_originating_gate"},
    {
      "id":"V3-G8","name":"aesthetic_fingerprint_and_de_ai",
      "preconditions":["no_open_blocker","scene_order_stable","ending_direction_stable","V3_G6D_pass"],
      "sample_states":["verified_personal_samples","baseline_only_samples_missing"],
      "artifacts":["aesthetic_fingerprint","line_edit_report","dialogue_pattern_family_ledger"],
      "required_evidence":["dominant_repeated_patterns","minimal_edits","voice_preserved","plot_facts_unchanged","no_mechanical_action_or_object_substitution","no_explanatory_tail","cross_scene_dialogue_pattern_family_inventory","separated_scene_recurrence","cross_character_cadence_homogenization_check","character_and_scene_specificity","portable_pattern_risk","pattern_mechanism_variation","pattern_cadence_variation","no_universal_numeric_density_threshold"],
      "risk_codes":["DIALOGUE_TEMPLATE_FAMILY_DENSITY_RISK"],
      "principles":{"single_instance_is_not_density_proof":true,"humor_frequency_is_not_density_proof":true,"cross_scene_low_specificity_recurrence_is_primary_signal":true,"no_universal_numeric_cutoff":true},
      "on_fail":"target_repeated_pattern_family_then_recheck_changed_dialogue_and_G8"
    }
  ],
  "delivery": {
    "allow_when":["no_open_blocker","primary_scene_chain_proven","primary_emotion_debt_paid_or_intentional_risk_recorded","protagonist_costly_choice_present","opening_cold_read_completed","changed_locations_rechecked","dialogue_candidate_inventory_complete","rhetorical_ladder_audit_complete","dialogue_epistemic_scope_checked","dialogue_grounding_and_local_semantic_logic_passed","dialogue_pattern_family_density_checked","de_ai_did_not_change_story_facts"],
    "never_accept_as_sufficient":["numeric_self_score","all_files_exist","all_boxes_checked","multiple_same_context_personas_agree"]
  }
}
