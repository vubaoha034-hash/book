{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-distillation/scene_card.schema.json",
  "title": "Scene Card V1",
  "description": "Future analysis container only. STEP-01 does not populate literary judgments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_id",
    "work_id",
    "chapter_id",
    "source_span",
    "characters",
    "character_goals",
    "constraints",
    "trigger",
    "conflict",
    "action",
    "outcome",
    "state_change",
    "reader_information_gain",
    "character_information_gain",
    "emotion_before",
    "emotion_after",
    "setup",
    "payoff",
    "evidence_refs",
    "confidence",
    "analyst_notes"
  ],
  "properties": {
    "scene_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "chapter_id": {"type": "string", "minLength": 1},
    "source_span": {"$ref": "#/$defs/sourceSpan"},
    "characters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "character_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character", "goal", "evidence_refs"],
        "properties": {
          "character": {"type": "string"},
          "goal": {"type": "string"},
          "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "trigger": {"type": ["string", "null"]},
    "conflict": {"type": ["string", "null"]},
    "action": {"type": ["string", "null"]},
    "outcome": {"type": ["string", "null"]},
    "state_change": {"type": ["string", "null"]},
    "reader_information_gain": {"type": "array", "items": {"type": "string"}},
    "character_information_gain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character", "information", "evidence_refs"],
        "properties": {
          "character": {"type": "string"},
          "information": {"type": "string"},
          "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "emotion_before": {"type": ["string", "null"]},
    "emotion_after": {"type": ["string", "null"]},
    "setup": {"$ref": "#/$defs/claims"},
    "payoff": {"$ref": "#/$defs/claims"},
    "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "analyst_notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_char", "end_char"],
      "properties": {
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 0},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "chapter_id", "source_span", "quote_sha256"],
      "properties": {
        "work_id": {"type": "string"},
        "chapter_id": {"type": "string"},
        "source_span": {"$ref": "#/$defs/sourceSpan"},
        "quote_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "evidence_refs"],
        "properties": {
          "description": {"type": "string"},
          "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    }
  }
}
