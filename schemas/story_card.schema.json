{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-distillation/story_card.schema.json",
  "title": "Story Card Evidence Contract V1",
  "description": "Future analysis container. Important interpretations carry explicit epistemic status and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_id", "premise", "core_character_goals", "character_relations", "power_relations",
    "causal_chain", "conflict_chain", "emotion_curve", "information_release", "setup_payoff",
    "chapter_hooks", "reusable_mechanisms", "genre_specific_mechanisms", "failure_patterns",
    "counterexamples", "evidence_refs"
  ],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "premise": {"type": ["string", "null"]},
    "core_character_goals": {"$ref": "#/$defs/claims"},
    "character_relations": {"$ref": "#/$defs/claims"},
    "power_relations": {"$ref": "#/$defs/claims"},
    "causal_chain": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "from_scene_id", "to_scene_id", "cause", "consequence", "claim_type",
          "epistemic_status", "confidence", "evidence_refs"
        ],
        "properties": {
          "from_scene_id": {"type": "string"},
          "to_scene_id": {"type": "string"},
          "cause": {"type": "string"},
          "character_choice": {"type": ["string", "null"]},
          "consequence": {"type": "string"},
          "claim_type": {"type": "string", "enum": ["causal_interpretation"]},
          "epistemic_status": {"$ref": "#/$defs/epistemicStatus"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "conflict_chain": {"$ref": "#/$defs/claims"},
    "emotion_curve": {"$ref": "#/$defs/claims"},
    "information_release": {"$ref": "#/$defs/claims"},
    "setup_payoff": {"$ref": "#/$defs/claims"},
    "chapter_hooks": {"$ref": "#/$defs/claims"},
    "reusable_mechanisms": {"$ref": "#/$defs/claims"},
    "genre_specific_mechanisms": {"$ref": "#/$defs/claims"},
    "failure_patterns": {"$ref": "#/$defs/claims"},
    "counterexamples": {"$ref": "#/$defs/claims"},
    "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceSpan": {
      "type": "object", "additionalProperties": false,
      "required": ["start_char", "end_char"],
      "properties": {
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 0}
      }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["work_id", "chapter_id", "chapter_text_sha256", "span_scope", "source_span", "quote_sha256"],
      "properties": {
        "work_id": {"type": "string", "minLength": 1},
        "chapter_id": {"type": "string", "minLength": 1},
        "chapter_text_sha256": {"$ref": "#/$defs/sha256"},
        "span_scope": {"const": "chapter_text", "type": "string"},
        "source_span": {"$ref": "#/$defs/sourceSpan"},
        "quote_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
    "epistemicStatus": {"type": "string", "enum": ["observed", "inferred", "hypothesis"]},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_type", "description", "epistemic_status", "confidence", "evidence_refs"],
      "properties": {
        "claim_type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "epistemic_status": {"$ref": "#/$defs/epistemicStatus"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  }
}
