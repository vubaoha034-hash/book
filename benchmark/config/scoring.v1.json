{
  "schema_version": "1.0.0",
  "benchmark": "novel-distillation-benchmark",
  "score_total": 100,
  "dimensions": [
    {"id": "source_evidence", "name": "原作理解与证据", "weight": 10},
    {"id": "character_model", "name": "人物模型", "weight": 15},
    {"id": "plot_structure", "name": "剧情结构", "weight": 15},
    {"id": "style_rhythm", "name": "文风与节奏", "weight": 15},
    {"id": "longform_consistency", "name": "长篇一致性", "weight": 15},
    {"id": "generalization_originality", "name": "泛化与原创", "weight": 10},
    {"id": "new_chapter_quality", "name": "实际新章质量", "weight": 15},
    {"id": "engineering_efficiency", "name": "工程效率", "weight": 5}
  ],
  "hard_gates": [
    {
      "id": "B-G0",
      "name": "source_integrity",
      "fail_if": [
        "source_text_modified_without_new_hash",
        "generated_text_mixed_into_source_corpus",
        "private_copyright_text_committed_to_public_repo"
      ]
    },
    {
      "id": "B-G1",
      "name": "coverage_claim_integrity",
      "fail_if": [
        "sampled_analysis_claimed_as_full_book",
        "production_full_book_claim_without_successful_units_equal_source_units"
      ]
    },
    {
      "id": "B-G2",
      "name": "evidence_traceability",
      "fail_if": [
        "critical_claim_has_no_source_locator",
        "evidence_locator_points_to_nonexistent_source_unit"
      ]
    },
    {
      "id": "B-G3",
      "name": "holdout_isolation",
      "fail_if": [
        "holdout_seen_by_distiller",
        "holdout_seen_by_rag",
        "holdout_summary_or_notes_seen_by_writer",
        "future_holdout_leaked_by_later_chapters"
      ]
    },
    {
      "id": "B-G4",
      "name": "reproducibility",
      "fail_if": [
        "missing_source_hash",
        "missing_upstream_version",
        "missing_model_or_prompt_version",
        "missing_run_manifest"
      ]
    },
    {
      "id": "B-G5",
      "name": "experiment_isolation",
      "fail_if": [
        "multiple_major_variables_changed_without_ablation",
        "different_input_or_budget_between_compared_variants"
      ]
    },
    {
      "id": "B-G6",
      "name": "review_independence",
      "fail_if": [
        "same_context_roleplay_claimed_as_independent_human_or_judge",
        "variant_identity_exposed_in_blind_writing_test"
      ]
    },
    {
      "id": "B-G7",
      "name": "license_boundary",
      "fail_if": [
        "upstream_code_copied_before_license_review",
        "incompatible_license_code_merged"
      ]
    }
  ],
  "experiment_rules": {
    "baseline_must_be_unmodified_upstream": true,
    "max_major_variables_per_experiment": 1,
    "same_model_required_for_direct_comparison": true,
    "same_input_required_for_direct_comparison": true,
    "same_budget_required_for_direct_comparison": true,
    "blind_labels_required_for_final_writing_comparison": true,
    "self_score_cannot_be_primary_evidence": true,
    "feature_count_has_zero_score": true
  },
  "patch_acceptance": {
    "all_hard_gates_must_pass": true,
    "minimum_total_score_delta": 1.0,
    "minimum_target_dimension_delta": 1.5,
    "maximum_allowed_regression_in_any_protected_dimension": 1.0,
    "if_effect_is_smaller_than_threshold": "mark_inconclusive_and_repeat",
    "sunk_cost_is_not_acceptance_evidence": true
  },
  "promotion_tiers": {
    "baseline": "measured only; no quality claim",
    "candidate": "all gates pass and repeated comparison is non-inferior to best baseline",
    "preferred": "all gates pass and repeated blind tests show a material improvement",
    "production": "preferred plus long-book stress, hidden-set validation, and regression suite pass"
  }
}
