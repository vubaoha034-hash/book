# Keep private source books local. Do not publish copyrighted books by accident.
_private/
**/_private/
sources/books/*
!sources/books/.gitkeep

# Book archive formats are never valid public-repository artifacts here.
*.epub
*.mobi
*.azw
*.azw3

# Extracted text may contain source material. Keep private.
library/_extracted/*
!library/_extracted/.gitkeep

# Benchmark private data. Never publish source corpora, holdouts, generated runs,
# cached source-derived artifacts, or local upstream checkouts from this public repo.
benchmark/_private/
benchmark/runs/
benchmark/cache/
benchmark/upstream_checkouts/
benchmark/blind_packets/private/

# Local caches
__pycache__/
*.pyc
.DS_Store
