  "located_evidence": [
    {
      "evidence_id": "E01",
      "source_id": "historical_v3",
      "line_start": 13,
      "line_end": 13,
      "quote": "罗钧身后有人拖着行李箱，轮子一下一下撞在地砖缝上。大厅里冷气开得过头，他把手里的文件袋换到另一只手。里面是购房合同、付款凭证、贷款结清证明，还有他这几年攒下来的所有能证明“这套房今天应该属于我”的东西。",
      "use_scope": "HISTORICAL_PROSE_NOT_CURRENT_ACCEPTED_FRONT",
      "coordinator_interpretation": "多年准备、购房材料与今天应属于自己的房子已有正文依据；不证明文学效果。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E02",
      "source_id": "historical_v3",
      "line_start": 81,
      "line_end": 81,
      "quote": "下午去拿钥匙，晚上第一次睡进真正属于自己的房子。客厅没买沙发，次卧还空着，他已经在购物车里放了一张一米五的床，等过户完成再下单。",
      "use_scope": "HISTORICAL_PROSE_NOT_CURRENT_ACCEPTED_FRONT",
      "coordinator_interpretation": "已写晚上第一次住进自己的房子；床及家具细节不纳入本包。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E03",
      "source_id": "historical_v4",
      "line_start": 13,
      "line_end": 13,
      "quote": "后面有人拖着行李箱，轮子卡在地砖缝里，咯噔、咯噔。罗钧往旁边让了半步，文件袋还夹在胳膊下。购房合同、付款凭证、贷款结清证明都在里面。他原本打算办完手续就去拿钥匙。",
      "use_scope": "HISTORICAL_REJECTED_PROSE_ONLY",
      "coordinator_interpretation": "旧V4已写办完手续取钥匙。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E04",
      "source_id": "historical_v4",
      "line_start": 65,
      "line_end": 65,
      "quote": "他本来只给这件事留了一个上午。下午拿钥匙，晚上搬个行李箱过去。客厅连沙发都还没有，次卧那张一米五的床躺在购物车里，他一直忍着没付款，想等房本手续走完。",
      "use_scope": "HISTORICAL_REJECTED_PROSE_ONLY",
      "coordinator_interpretation": "旧V4已写晚上搬过去；未呈现全部多年首付不能推出其他版本也缺失。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E05",
      "source_id": "historical_opening_trial",
      "line_start": 17,
      "line_end": 17,
      "quote": "罗钧松开手。他原本下午要去取钥匙，搬家的车已经约好；司机刚发来消息问能不能提前半小时。罗钧回了句“等我电话”，没发出去，又删掉。",
      "use_scope": "EXCLUDED_DETAILS_NOT_NEW_CANON",
      "coordinator_interpretation": "搬家车和司机只是被否决opening trial的细节；不采用为本次冻结事实。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E06",
      "source_id": "historical_opening_trial",
      "line_start": 33,
      "line_end": 33,
      "quote": "“别扔。”她说，“我现在过去。”",
      "use_scope": "HISTORICAL_REJECTED_PROSE_ONLY",
      "coordinator_interpretation": "这版电话结尾与当前冻结输入不同；不能当成448字稿唯一已接受前场。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E07",
      "source_id": "frozen_writer_input",
      "line_start": 5,
      "line_end": 5,
      "quote": "罗钧攒了多年首付，本来今天完成小公寓过户，晚上住进去。同一身份突然多出他毫无记忆的另一套三年经历，过户中止，30天冲突窗口刚开始。前场许澄来电问过户是否停了；他问是否认识，她说：“你现在是不认识。”",
      "use_scope": "CURRENT_FROZEN_FACT_INPUT_NOT_PROSE_ACCEPTANCE",
      "coordinator_interpretation": "当前输入已经给多年首付、原本今晚入住及电话结尾；采用这些事实，历史写作命令不执行。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E08",
      "source_id": "frozen_writer_input",
      "line_start": 9,
      "line_end": 9,
      "quote": "许澄记得共同生活、经营摄影工作室和签设备款协议的三年。她明知他不记得，见到熟悉的人仍残留熟悉期待，被当成来碰首付的陌生讨款者会触及她的经历和尊严。她不逼他假装记得，也不愿为了体谅他把共同责任吞下。她有自己的后期业务要做，能给这次协助的时间有限；他把事情推后，不能当然要求她随时解释、安排和等待。她可以限定配合时间，但不扣住独立证据或阻挡他自行查证。",
      "use_scope": "CURRENT_FROZEN_CHARACTER_FACT_INPUT",
      "coordinator_interpretation": "许澄熟悉期待及自己的业务、有限协助已经在人物输入里；不必另造亲密往事。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E09",
      "source_id": "target",
      "line_start": 3,
      "line_end": 3,
      "quote": "许澄叫了声“罗钧”，声音比电话里软。他以为她要拦，先看向大厅入口。",
      "use_scope": "CURRENT_TARGET_DEFINITE_TEXT",
      "coordinator_interpretation": "现稿已有当面称名、软声及他的大厅注意力；只改变将来进入点，不增加新会面。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E10",
      "source_id": "target",
      "line_start": 13,
      "line_end": 13,
      "quote": "“我三点得走，客户的片子还等着。”许澄看了眼表，“五天后那笔款也不会停。今天查不完，你以后可以自己查，但别把‘以后再说’当成已经处理了。”",
      "use_scope": "CURRENT_TARGET_DEFINITE_TEXT",
      "coordinator_interpretation": "三点离开用于客户工作，五天款项仍到期；不等于20分钟后窗口关闭。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E11",
      "source_id": "target",
      "line_start": 15,
      "line_end": 15,
      "quote": "罗钧也看表，还剩二十分钟。那二十分钟本来该留给大厅里的房子，不该留给一个陌生女人和一段他毫无印象的过去。",
      "use_scope": "CURRENT_EXCERPT_ONLY_NOT_WHOLE_STORY_GAP",
      "coordinator_interpretation": "原稿二十分钟和房子竞争；私人住房价值未在这份摘录明确呈现。",
      "exact_location_checked": true
    },
    {
      "evidence_id": "E12",
      "source_id": "target",
      "line_start": 25,
      "line_end": 25,
      "quote": "罗钧坐下来，掏出手机，照着合同上的公司名一个字一个字输进搜索框。购房文件袋还压在他手肘下，像只要不松开，今天原本属于他的事就还没被挤走。",
      "use_scope": "CURRENT_TARGET_DEFINITE_TEXT",
      "coordinator_interpretation": "只开始搜索公司名，无核验结果或责任认领；本次准备保留短段边界。",
      "exact_location_checked": true
    }
  ],
